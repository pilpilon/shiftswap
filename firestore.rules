rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Users can only read/write their own document
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Business data: only the business owner (uid == businessId) can access
    match /businesses/{businessId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == businessId;
    }

    // WhatsApp sessions: only accessible by the business owner
    match /whatsapp_sessions/{businessId} {
      allow read, write: if request.auth != null && request.auth.uid == businessId;
    }

    // Deny all other access by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
